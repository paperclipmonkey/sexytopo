<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	    Required by Compose Multiplatform itself, and its absence is a *crash*, not a slow app.
	    `androidx.compose.ui.uikit.PlistSanityCheck` reads this key and calls `error()` if it is
	    missing or false — from a low-priority background queue, so the throw lands whenever that
	    queue next gets CPU rather than at launch, which is why it looked like the overflow menu
	    was at fault.

	    It is also worth having on merit: without it iOS caps the display link at 60 Hz, so on a
	    120 Hz iPhone the sketch would pan and draw at half the rate the screen can manage.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	    Required from iOS 13. Without it, simply constructing a CBCentralManager raises
	    NSInternalInconsistencyException and the app dies on the spot - so an iOS build that
	    forgets this does not merely fail to find instruments, it crashes the first time a
	    surveyor taps connect. The string is shown verbatim in the permission prompt, so it says
	    what the app wants the radio for rather than restating that it wants the radio.
	-->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>SexyTopo connects to your cave survey instrument to read distance, compass and clino measurements.</string>
	<!--
	    Surveys are a folder of plain JSON files, and a caver has to get them off the phone and
	    into Therion or Survex. These two keys put that folder in the Files app, which is the iOS
	    counterpart of the Storage Access Framework folder the Android app asks for - and, unlike
	    it, needs no code at all.
	-->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!--
	    An empty UILaunchScreen dictionary is a plain white screen. Naming a colour from the asset
	    catalogue paints the launch screen in the same green as the app's panels, so the seconds
	    before Compose has drawn anything look like the app starting rather than like nothing
	    happening. There is no storyboard here on purpose: a launch screen may not run code, so
	    Compose cannot draw it, and a colour is the whole of what is worth saying.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!--
	    arm64, not the armv7 the old Xcode template emits: armv7 is 32-bit ARM, which nothing
	    running iOS 11 or later has, and Kotlin/Native builds this app for iosArm64 only.
	    Declaring armv7 required asks for a device the binary could not run on.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
